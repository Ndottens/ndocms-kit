---
import SiteLayout from 'virtual:ndocms/layout';
import SliceZone from 'ndocms-kit/components/SliceZone.astro';
import { registry } from 'virtual:ndocms/slices';
import { dividerStyle, sections } from 'virtual:ndocms/design';
import { getAllDocuments } from 'ndocms-kit/lib/delivery';
import { pageSeo } from 'ndocms-kit/lib/seo';
import type { DeliveryDocument, SliceInstance } from 'ndocms-kit/lib/types';

export async function getStaticPaths() {
    const documents = await getAllDocuments('landing_page');

    return documents.map((document) => ({
        // Het als homepage gemarkeerde document wordt de root (/); de rest /{uid}.
        params: { uid: document.is_homepage ? undefined : document.uid },
        props: { document },
    }));
}

interface Props {
    document: DeliveryDocument;
}

const { document } = Astro.props;
const slices = (document.data.slices ?? []) as SliceInstance[];
const seo = pageSeo(document);
const title = seo.title || document.uid;
---

<SiteLayout title={title} description={seo.description} image={seo.shareImage} robots={seo.robots} sitemap={seo.sitemap}>
    <SliceZone slices={slices} registry={registry} dividerStyle={dividerStyle} sections={sections} />
</SiteLayout>
