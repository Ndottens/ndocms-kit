---
// Story-editor bridge bootstrap. Used exclusively by the /_ndocms/render
// shell (see lib/preview.ts); production pages never import this component.
// The editor origin is derived at build time from NDOCMS_API_URL so no
// per-site configuration is needed.

const apiUrl = import.meta.env.NDOCMS_API_URL as string | undefined;
const editorOrigin = apiUrl ? new URL(apiUrl).origin : null;
---

{editorOrigin && <script type="application/json" id="ndocms-bridge-config" set:html={JSON.stringify({ editorOrigin })} />}

<script>
    import { initPreviewBridge } from '../lib/preview-bridge';

    initPreviewBridge();
</script>
