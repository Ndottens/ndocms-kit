---
// A dependency-free scroll-snap slider. The kit owns the mechanics (track,
// dots, arrows, keyboard, resize); the slice owns the aesthetics AND the item
// sizing: every direct child of the default slot must carry literal classes
// like `snap-start shrink-0 basis-full` (1 per view) or
// `snap-start shrink-0 basis-[85%] md:basis-1/3` (hero cards that become a
// swipe slider on mobile). Items per view is derived from those widths.
//
// Progressive enhancement: without JS this is a native swipeable scroll-snap
// row; the controls stay hidden until <nk-slider> is defined (see the
// `nk-slider:not(:defined)` rule in styles/layout.css).
//
// Colors follow `currentColor`: set a text color on the wrapper (or pass
// `class`) and the dots and arrows follow.

interface Props {
    // aria-label for the carousel region; name what it contains ("Events").
    label: string;
    dots?: boolean;
    arrows?: boolean;
    class?: string;
    // Extra classes on the track, next to the snap/overflow mechanics — gaps
    // and edge padding live here (`gap-6 px-1`).
    trackClass?: string;
}

const { label, dots = true, arrows = true, class: className, trackClass } = Astro.props;
---

<nk-slider class={`block ${className ?? ''}`} role="region" aria-roledescription="carousel" aria-label={label}>
    <div
        data-nk-slider-track
        class={`flex snap-x snap-mandatory overflow-x-auto scroll-smooth [scrollbar-width:none] [&::-webkit-scrollbar]:hidden ${trackClass ?? ''}`}
        tabindex="0"
    >
        <slot />
    </div>

    {(dots || arrows) && (
        <div data-nk-slider-controls class="mt-6 flex items-center justify-between gap-4">
            {dots ? <div data-nk-slider-dots class="flex items-center gap-2" /> : <div />}
            {arrows && (
                <div class="flex items-center gap-2">
                    <button
                        type="button"
                        data-nk-slider-prev
                        class="flex h-10 w-10 items-center justify-center rounded-full border border-current/25 transition hover:border-current disabled:opacity-30 disabled:hover:border-current/25"
                        aria-label="Vorige"
                    >
                        <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                            <path d="M10 3 5 8l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </button>
                    <button
                        type="button"
                        data-nk-slider-next
                        class="flex h-10 w-10 items-center justify-center rounded-full border border-current/25 transition hover:border-current disabled:opacity-30 disabled:hover:border-current/25"
                        aria-label="Volgende"
                    >
                        <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                            <path d="m6 3 5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </button>
                </div>
            )}
        </div>
    )}
</nk-slider>

<script>
    class NkSlider extends HTMLElement {
        private track!: HTMLElement;
        private dotsHost: HTMLElement | null = null;
        private prev: HTMLButtonElement | null = null;
        private next: HTMLButtonElement | null = null;
        private observer: ResizeObserver | null = null;
        private scheduled = false;

        connectedCallback() {
            const track = this.querySelector<HTMLElement>('[data-nk-slider-track]');
            if (!track) return;
            this.track = track;
            this.dotsHost = this.querySelector('[data-nk-slider-dots]');
            this.prev = this.querySelector('[data-nk-slider-prev]');
            this.next = this.querySelector('[data-nk-slider-next]');

            this.prev?.addEventListener('click', () => this.step(-1));
            this.next?.addEventListener('click', () => this.step(1));
            this.track.addEventListener('scroll', () => this.schedule());
            this.track.addEventListener('keydown', (e) => {
                if (e.key === 'ArrowLeft') { e.preventDefault(); this.step(-1); }
                if (e.key === 'ArrowRight') { e.preventDefault(); this.step(1); }
            });
            this.observer = new ResizeObserver(() => this.schedule());
            this.observer.observe(this.track);
            this.sync();
        }

        disconnectedCallback() {
            this.observer?.disconnect();
        }

        private items(): HTMLElement[] {
            return Array.from(this.track.children) as HTMLElement[];
        }

        private itemStride(): number {
            const items = this.items();
            if (items.length < 2) return items[0]?.offsetWidth || this.track.clientWidth;
            return items[1].offsetLeft - items[0].offsetLeft;
        }

        private pageCount(): number {
            const stride = this.itemStride();
            const perView = Math.max(1, Math.round(this.track.clientWidth / stride));
            return Math.max(1, this.items().length - perView + 1);
        }

        private page(): number {
            return Math.round(this.track.scrollLeft / this.itemStride());
        }

        private step(direction: number) {
            this.track.scrollBy({ left: direction * this.itemStride(), behavior: 'smooth' });
        }

        private schedule() {
            if (this.scheduled) return;
            this.scheduled = true;
            requestAnimationFrame(() => {
                this.scheduled = false;
                this.sync();
            });
        }

        private sync() {
            const pages = this.pageCount();
            const page = Math.min(this.page(), pages - 1);

            if (this.prev) this.prev.disabled = page <= 0;
            if (this.next) this.next.disabled = page >= pages - 1;

            if (!this.dotsHost) return;
            if (this.dotsHost.children.length !== pages) {
                this.dotsHost.replaceChildren(
                    ...Array.from({ length: pages }, (_, i) => {
                        const dot = document.createElement('button');
                        dot.type = 'button';
                        dot.className = 'h-2 w-2 rounded-full bg-current transition-opacity';
                        dot.setAttribute('aria-label', `Ga naar item ${i + 1}`);
                        dot.addEventListener('click', () => {
                            this.track.scrollTo({ left: i * this.itemStride(), behavior: 'smooth' });
                        });
                        return dot;
                    }),
                );
            }
            Array.from(this.dotsHost.children).forEach((dot, i) => {
                (dot as HTMLElement).style.opacity = i === page ? '1' : '0.25';
                dot.setAttribute('aria-current', i === page ? 'true' : 'false');
            });
        }
    }

    if (!customElements.get('nk-slider')) {
        customElements.define('nk-slider', NkSlider);
    }
</script>
