---
import SectionDivider from './SectionDivider.astro';
import { chromeIsDark, isChrome, splitChrome, type DividerStyle, type SectionPlan, type Surface } from '../lib/design';
import type { SliceInstance } from '../lib/types';

// Renders a document's slice zone: maps each slice to the site's component
// (via the injected registry), alternates light/muted surfaces, places
// dividers between differing surfaces and sets the anchor targets for
// section links. The registry, dividerStyle and sections are per-site design;
// the mechanics here are shared and name no slice type.

interface Props {
    slices: SliceInstance[];
    registry: Record<string, any>;
    dividerStyle: DividerStyle;
    /** Per-project: which sections are chrome, and which have a fixed surface. */
    sections?: SectionPlan;
}

const { slices, registry, dividerStyle, sections } = Astro.props;

const chrome = sections?.chrome ?? isChrome;
const surfaceFor = sections?.surfaceFor ?? chromeIsDark;

// Auto-rhythm: alternate the neutral sections so two identical backgrounds
// never sit next to each other. A section with a fixed surface sits outside the
// rhythm and leaves its neighbours' alternation untouched. Slices keep their
// own padding.
let toggle: Surface = 'light';
let flip = false;
const resolved = slices
    .filter((slice) => registry[slice.sliceType])
    .map((slice) => {
        const fixed = surfaceFor(slice);
        let surface: Surface;
        if (fixed !== null) {
            surface = fixed;
        } else {
            surface = toggle;
            toggle = toggle === 'light' ? 'muted' : 'light';
        }
        // Anchor target for section links: slice-instance id with '$' -> '-'.
        const anchorId = typeof slice.id === 'string' && slice.id !== '' ? slice.id.replace('$', '-') : undefined;
        return { slice, surface, anchorId, Component: registry[slice.sliceType] };
    })
    // Dividers are computed over the whole list, before the <main> split below.
    .map((r, i, all) => {
        const prev = all[i - 1];
        const divider = i > 0 && prev.surface !== r.surface;
        if (divider) flip = !flip;
        return { ...r, divider, dividerFrom: prev?.surface, dividerFlip: flip };
    });

// Sections render in the order the editor put them in. The <main> landmark
// spans the block from the first to the last content section, so chrome above
// or below it stays outside — for the usual "navigation first, footer last"
// page that is the same output as before. Chrome deliberately placed among the
// content lands inside <main>; that is valid HTML and reads as navigation or a
// footer scoped to that content.
const { before, content, after } = splitChrome(resolved, (r) => r.slice, chrome);
---

{
    before.map((r) => (
        <>
            {r.divider && <SectionDivider from={r.dividerFrom!} to={r.surface} style={dividerStyle} flip={r.dividerFlip} />}
            <div id={r.anchorId} data-ndocms-slice={r.slice.id} class="scroll-mt-20">
                <r.Component slice={r.slice} surface={r.surface} />
            </div>
        </>
    ))
}
{
    content.length > 0 && (
        <main>
            {content.map((r) => (
                <>
                    {r.divider && <SectionDivider from={r.dividerFrom!} to={r.surface} style={dividerStyle} flip={r.dividerFlip} />}
                    <div id={r.anchorId} data-ndocms-slice={r.slice.id} class="scroll-mt-20">
                        <r.Component slice={r.slice} surface={r.surface} />
                    </div>
                </>
            ))}
        </main>
    )
}
{
    after.map((r) => (
        <>
            {r.divider && <SectionDivider from={r.dividerFrom!} to={r.surface} style={dividerStyle} flip={r.dividerFlip} />}
            <div id={r.anchorId} data-ndocms-slice={r.slice.id} class="scroll-mt-20">
                <r.Component slice={r.slice} surface={r.surface} />
            </div>
        </>
    ))
}
