---
import type { DividerStyle } from '../lib/design';

type Surface = 'light' | 'muted' | 'dark';

interface Props {
    from: Surface;
    to: Surface;
    style: DividerStyle;
    flip?: boolean;
}

const { from, to, style, flip = false } = Astro.props;

const bg: Record<Surface, string> = { light: 'bg-surface', muted: 'bg-surface-muted', dark: 'bg-surface-inverse' };
const fill: Record<Surface, string> = { light: 'fill-surface', muted: 'fill-surface-muted', dark: 'fill-surface-inverse' };

// De strip heeft de kleur van de bovenliggende sectie (`from`); de SVG-vorm is
// gevuld met de kleur van de onderliggende sectie (`to`) en komt zo omhoog.
// `flip` spiegelt de richting, zodat opeenvolgende dividers elkaar afwisselen.
const svgClass = `block h-10 w-full md:h-16 ${fill[to]}`;
const anglePoints = flip ? '0,0 1200,80 0,80' : '0,80 1200,0 1200,80';
const curvePath = flip ? 'M0,0 C400,80 800,80 1200,0 L1200,80 L0,80 Z' : 'M0,80 C400,0 800,0 1200,80 Z';
---

{style === 'line' && (
    <div class={bg[from]}>
        <div class="mx-auto max-w-7xl border-t border-ink/10"></div>
    </div>
)}

{style === 'angle' && (
    <div class={`${bg[from]} leading-none`}>
        <svg class={svgClass} viewBox="0 0 1200 80" preserveAspectRatio="none" aria-hidden="true">
            <polygon points={anglePoints} />
        </svg>
    </div>
)}

{style === 'curve' && (
    <div class={`${bg[from]} leading-none`}>
        <svg class={svgClass} viewBox="0 0 1200 80" preserveAspectRatio="none" aria-hidden="true">
            <path d={curvePath} />
        </svg>
    </div>
)}

{style === 'wave' && (
    <div class={`${bg[from]} leading-none`}>
        <svg class={svgClass} viewBox="0 0 1200 80" preserveAspectRatio="none" aria-hidden="true">
            <path d="M0,40 C150,80 350,0 600,40 C850,80 1050,0 1200,40 L1200,80 L0,80 Z" />
        </svg>
    </div>
)}
