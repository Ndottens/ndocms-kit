---
// SVG icons (Feather-style). The names and paths live in lib/icons.ts, which the
// CMS editor reads too.
import { iconPath } from '../lib/icons';

interface Props {
    name?: string;
    class?: string;
    // The blueprint decides the line weight; Feather's own default is 2.
    strokeWidth?: number | string;
}
const { name, class: className, strokeWidth = 2 } = Astro.props;

const inner = iconPath(name);
---

{inner && <svg class={className} data-ndocms-icon={name} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" set:html={inner} />}
