---
// Standard image render. Always emits width/height so the browser reserves space
// and the page doesn't shift while loading (good CLS). Above-the-fold images
// (hero) should pass loading="eager"; everything else stays lazy.
//
// When the CMS published responsive variants, they become a srcset so the
// browser downloads the smallest sharp version. Pass `sizes` when the image
// renders narrower than the viewport (e.g. "(min-width: 1024px) 50vw, 100vw").
//
// A focal point (library default, or a per-placement override on the field)
// becomes object-position, so object-cover crops keep the important part of
// the image in view. A per-placement fit of 'contain' shows the full image
// uncropped; the inline style deliberately overrides the slice's object-cover
// class.
import type { ImageValue } from '../lib/types';

interface Props {
    image: ImageValue;
    class?: string;
    loading?: 'lazy' | 'eager';
    sizes?: string;
}

const { image, class: className, loading = 'lazy', sizes } = Astro.props;

const variants = image.variants ?? [];
const srcset = variants.length
    ? [
          ...variants.map((variant) => `${variant.url} ${variant.width}w`),
          image.width ? `${image.url} ${image.width}w` : null,
      ]
          .filter(Boolean)
          .join(', ')
    : undefined;

const styleParts = [];
if (image.focalX != null && image.focalY != null) {
    styleParts.push(`object-position: ${image.focalX}% ${image.focalY}%`);
}
if (image.fit === 'contain') {
    styleParts.push('object-fit: contain');
}
const style = styleParts.length ? styleParts.join('; ') : undefined;
---

<img
    src={image.url}
    srcset={srcset}
    sizes={srcset ? (sizes ?? '100vw') : undefined}
    alt={image.alt ?? ''}
    width={image.width ?? undefined}
    height={image.height ?? undefined}
    loading={loading}
    decoding="async"
    style={style}
    class={className}
/>
