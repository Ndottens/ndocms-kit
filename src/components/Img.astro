---
// Renders a CMS image. One rule runs through everything here: a box has exactly
// one owner, and the slice says who that is.
//
//   box="cms"   the editor decides. Only for fields whose config allows shapes.
//               This component emits the box; your `class` lands on it.
//   box="fill"  the slice decides. Wrap the image in your own sized container
//               (`aspect-[3/4]`, `h-44`, `h-10 w-10`) and pass the usual
//               `absolute inset-0 h-full w-full object-cover`. Any shape still
//               sitting on the value is ignored, and reported while developing.
//
// Getting this wrong used to be silent and ugly. A slice would size its own
// container while the editor's shape was still applied to the <img> inside it.
// The container won the aspect ratio but not the border-radius, so a circle on a
// 4/3 box rendered as an ellipse. That is no longer constructible: when the CMS
// owns the box, this component renders the box.
//
// About fit: 'contain' means "no crop". It does NOT letterbox the photo inside a
// forced shape — empty bands inside a bordered box read as a thick frame, and a
// contained photo behind a circular mask reads as an oval sliver. No crop means
// the box follows the photo, which is what an editor means by it. It also
// matches the editor UI, which disables the focal point under 'contain' because
// there is nothing left to aim.
import type { ImageShape, ImageValue } from '../lib/types';

interface Props {
    image: ImageValue;
    // Who owns the box. No default: picking one is a real decision, and a wrong
    // guess is exactly the bug this component exists to prevent.
    box: 'cms' | 'fill';
    class?: string;
    loading?: 'lazy' | 'eager';
    sizes?: string;
    // Only used to point the dev warning at the right field.
    field?: string;
}

const SHAPE_RATIOS: Record<Exclude<ImageShape, 'original'>, [number, number]> = {
    square: [1, 1],
    portrait: [3, 4],
    landscape: [4, 3],
    wide: [16, 9],
    circle: [1, 1],
};

const { image, box, class: className, loading = 'lazy', sizes, field } = Astro.props;

const variants = image.variants ?? [];
const srcset = variants.length
    ? [
          ...variants.map((variant) => `${variant.url} ${variant.width}w`),
          image.width ? `${image.url} ${image.width}w` : null,
      ]
          .filter(Boolean)
          .join(', ')
    : undefined;

const cmsShape = image.shape && image.shape !== 'original' ? image.shape : null;

// 'contain' means no crop, so a shape would contradict it. The editor greys the
// picker out under 'contain', but older content can still carry both.
const shape = box === 'cms' && image.fit !== 'contain' ? cmsShape : null;
const ratio = shape ? SHAPE_RATIOS[shape] : null;

// A shape the slice will never honour means the field config and the design
// disagree. Say so while building, instead of letting it surface on the site as
// a crop nobody asked for.
if (import.meta.env.DEV && cmsShape && box !== 'cms') {
    console.warn(
        `[ndocms-kit] Img: image${field ? ` "${field}"` : ''} carries shape "${cmsShape}" from the CMS, but this placement uses box="fill" and ignores it. Either render it with box="cms", or set shapes: [] on the field so editors are not offered a control that does nothing.`,
    );
}

// Always emit width/height so the browser reserves the exact box and the page
// doesn't shift while loading. With a shape the reserved box is the shape's box.
const width = image.width ?? undefined;
const height = ratio
    ? width
        ? Math.round((width / ratio[0]) * ratio[1])
        : undefined
    : (image.height ?? undefined);

const focal =
    image.focalX != null && image.focalY != null
        ? `object-position: ${image.focalX}% ${image.focalY}%`
        : null;

// Only a shape needs a wrapper to clip against. Without one the <img> is the box
// and carries the class itself, so the markup stays as flat as it was.
const isCircle = shape === 'circle';
---

{
    ratio ? (
        <div
            class={className}
            style={`aspect-ratio: ${ratio[0]} / ${ratio[1]}; overflow: hidden${isCircle ? '; border-radius: 9999px' : ''}`}
        >
            <img
                src={image.url}
                srcset={srcset}
                sizes={srcset ? (sizes ?? '100vw') : undefined}
                alt={image.alt ?? ''}
                width={width}
                height={height}
                loading={loading}
                decoding="async"
                style={`height: 100%; width: 100%; object-fit: cover${focal ? `; ${focal}` : ''}`}
            />
        </div>
    ) : (
        <img
            src={image.url}
            srcset={srcset}
            sizes={srcset ? (sizes ?? '100vw') : undefined}
            alt={image.alt ?? ''}
            width={width}
            height={height}
            loading={loading}
            decoding="async"
            style={focal ?? undefined}
            class={className}
        />
    )
}
